<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LCK 美股 DAY TRADE WEB</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- TradingView Widget Script -->
    <script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap');
        body { font-family: 'Inter', system-ui, sans-serif; background-color: #0b0e14; color: #e2e8f0; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
        .glass-panel { background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08); }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

    <!-- Top Navigation -->
    <header class="border-b border-slate-800 bg-slate-950/80 sticky top-0 z-50 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="p-2 bg-emerald-500/10 border border-emerald-500/30 rounded-lg text-emerald-400">
                    <i class="fa-solid fa-chart-line text-xl"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="font-bold text-xl tracking-wide text-white">LCK 美股 DAY TRADE WEB</h1>
                        <span class="px-2 py-0.5 text-xs font-mono font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 rounded-full animate-pulse">REAL-TIME LIVE</span>
                    </div>
                    <p class="text-xs text-slate-400">TradingView K線圖 • 真實 API 行情 • 風險控管面板</p>
                </div>
            </div>
            <button onclick="toggleModal('apiModal')" class="px-3 py-1.5 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg border border-slate-700 transition flex items-center gap-1.5">
                <i class="fa-solid fa-key text-amber-400"></i><span>API 設定</span>
            </button>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 py-6 w-full space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- Left Chart -->
            <div class="lg:col-span-2 glass-panel rounded-xl p-4 flex flex-col h-[520px]">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-chart-candlestick text-emerald-400"></i>
                        <h2 class="font-bold text-sm text-slate-200">即時 K 線圖表</h2>
                        <span id="currentChartTicker" class="text-xs font-mono bg-slate-800 px-2 py-0.5 rounded text-emerald-400 border border-slate-700">NASDAQ:NVDA</span>
                    </div>
                    <div class="flex items-center gap-2 text-xs">
                        <span class="text-slate-400">快捷切換:</span>
                        <button onclick="changeSymbol('NASDAQ:NVDA')" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 rounded text-slate-300 font-mono">NVDA</button>
                        <button onclick="changeSymbol('NASDAQ:TSLA')" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 rounded text-slate-300 font-mono">TSLA</button>
                        <button onclick="changeSymbol('NASDAQ:AAPL')" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 rounded text-slate-300 font-mono">AAPL</button>
                        <button onclick="changeSymbol('NASDAQ:QQQ')" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 rounded text-slate-300 font-mono">QQQ</button>
                    </div>
                </div>
                <div class="w-full flex-grow rounded-lg overflow-hidden border border-slate-800 bg-slate-950" id="tv_chart_container"></div>
            </div>

            <!-- Right Quote Panel -->
            <div class="glass-panel rounded-xl p-5 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="font-bold text-sm text-slate-200 flex items-center gap-2">
                            <i class="fa-solid fa-bolt text-amber-400"></i>美股真實行情查詢
                        </h2>
                        <span class="text-[10px] text-slate-400 bg-slate-800 px-2 py-0.5 rounded">Live API</span>
                    </div>
                    <div class="flex gap-2 mb-4">
                        <input type="text" id="symbolInput" value="NVDA" class="w-full bg-slate-900 border border-slate-700 focus:border-emerald-500 rounded-lg px-3 py-2 text-sm font-mono uppercase text-white placeholder-slate-500 outline-none">
                        <button onclick="fetchStockQuote()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-medium px-4 py-2 rounded-lg text-sm transition flex items-center gap-1.5 shadow-lg">
                            <i class="fa-solid fa-magnifying-glass"></i><span>查詢</span>
                        </button>
                    </div>
                    <div id="quoteResultCard" class="bg-slate-900/90 border border-slate-800 rounded-lg p-4 space-y-3">
                        <div class="flex justify-between items-start">
                            <div>
                                <div class="text-xl font-bold font-mono text-white flex items-center gap-2">
                                    <span id="quoteSymbol">NVDA</span>
                                    <span class="text-[10px] bg-emerald-500/20 text-emerald-400 px-1.5 py-0.5 rounded border border-emerald-500/30">LIVE</span>
                                </div>
                                <div class="text-xs text-slate-400" id="quoteName">NVIDIA Corporation</div>
                            </div>
                            <div class="text-right">
                                <div class="text-2xl font-bold font-mono text-emerald-400" id="quotePrice">\$221.97</div>
                                <div class="text-xs font-mono text-emerald-400" id="quoteChange">+5.50 (+2.54%)</div>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-800/80 text-xs font-mono">
                            <div class="flex justify-between text-slate-400"><span>今日最高:</span><span class="text-slate-200" id="quoteHigh">\$222.19</span></div>
                            <div class="flex justify-between text-slate-400"><span>今日最低:</span><span class="text-slate-200" id="quoteLow">\$217.66</span></div>
                            <div class="flex justify-between text-slate-400"><span>今早開盤:</span><span class="text-slate-200" id="quoteOpen">\$220.96</span></div>
                            <div class="flex justify-between text-slate-400"><span>前日收盤:</span><span class="text-slate-200" id="quotePrevClose">\$216.47</span></div>
                        </div>
                        <button onclick="applyQuoteToCalculator()" class="w-full mt-2 bg-slate-800 hover:bg-slate-700 text-emerald-400 border border-emerald-500/30 font-medium py-2 rounded-lg text-xs transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-arrows-to-dot"></i><span>套用即時報價至倉位精算器</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Position Calculator & Log Section (Keep existing functionality) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 glass-panel rounded-xl p-5">
                <h2 class="font-bold text-sm text-slate-200 mb-4"><i class="fa-solid fa-calculator text-emerald-400 mr-2"></i>日內交易倉位與風控精算器</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                    <div><label class="block text-xs text-slate-400 mb-1">總資金 (USD)</label><input type="number" id="accountSize" value="10000" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm font-mono text-white outline-none"></div>
                    <div><label class="block text-xs text-slate-400 mb-1">單筆風險 (%)</label><input type="number" id="riskPercent" value="1" step="0.5" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm font-mono text-white outline-none"></div>
                    <div><label class="block text-xs text-slate-400 mb-1">交易代號</label><input type="text" id="tradeTicker" value="NVDA" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm font-mono uppercase text-white outline-none"></div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                    <div><label class="block text-xs text-slate-400 mb-1">預計買入價</label><input type="number" id="entryPrice" value="221.97" step="0.01" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm font-mono text-white outline-none"></div>
                    <div><label class="block text-xs text-slate-400 mb-1">停損價</label><input type="number" id="stopPrice" value="217.00" step="0.01" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm font-mono text-white outline-none"></div>
                    <div><label class="block text-xs text-slate-400 mb-1">目標停利價</label><input type="number" id="targetPrice" value="230.00" step="0.01" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm font-mono text-white outline-none"></div>
                </div>
                <div class="bg-slate-950/80 rounded-xl p-4 border border-slate-800 grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
                    <div><div class="text-[11px] text-slate-400">建議股數</div><div class="text-xl font-bold font-mono text-emerald-400" id="calcShares">20 股</div></div>
                    <div><div class="text-[11px] text-slate-400">投入資金</div><div class="text-lg font-bold font-mono text-slate-200" id="calcPositionValue">\$4,439.40</div></div>
                    <div><div class="text-[11px] text-slate-400">單股最大虧損</div><div class="text-lg font-bold font-mono text-rose-400" id="calcRiskPerShare">\$4.97</div></div>
                    <div><div class="text-[11px] text-slate-400">風報比 R:R</div><div class="text-xl font-bold font-mono text-emerald-400" id="calcRR">1 : 1.61</div></div>
                </div>
            </div>
            
            <!-- Checklist -->
            <div class="glass-panel rounded-xl p-5 flex flex-col justify-between">
                <div>
                    <h2 class="font-bold text-sm text-slate-200 mb-3"><i class="fa-solid fa-list-check text-emerald-400 mr-2"></i>進場前紀律 Check List</h2>
                    <div class="space-y-2 text-xs">
                        <label class="flex items-center gap-2 p-2 rounded bg-slate-900/60"><input type="checkbox" onchange="updateChecklist()" class="chk-item"> 大盤方向符合趨勢</label>
                        <label class="flex items-center gap-2 p-2 rounded bg-slate-900/60"><input type="checkbox" onchange="updateChecklist()" class="chk-item"> 關鍵位突破/回測確認</label>
                        <label class="flex items-center gap-2 p-2 rounded bg-slate-900/60"><input type="checkbox" onchange="updateChecklist()" class="chk-item"> 風報比大於 1:1.5</label>
                        <label class="flex items-center gap-2 p-2 rounded bg-slate-900/60"><input type="checkbox" onchange="updateChecklist()" class="chk-item"> 無近斯重大財報突襲</label>
                        <label class="flex items-center gap-2 p-2 rounded bg-slate-900/60"><input type="checkbox" onchange="updateChecklist()" class="chk-item"> 已預掛硬止損單</label>
                    </div>
                </div>
                <div class="mt-3 text-center"><span id="checklistStatus" class="text-xs font-semibold text-rose-400">⚠️ 請先勾選所有紀律檢查項</span></div>
            </div>
        </div>
    </main>

    <!-- JavaScript Logic -->
    <script>
        let currentQuoteData = null;

        // Ensure TradingView loads correctly
        window.addEventListener('DOMContentLoaded', () => {
            initTradingViewWidget('NASDAQ:NVDA');
            calculatePosition();
        });

        function initTradingViewWidget(symbol = 'NASDAQ:NVDA') {
            const container = document.getElementById('tv_chart_container');
            if(!container) return;
            container.innerHTML = '';
            
            if (typeof TradingView !== 'undefined') {
                new TradingView.widget({
                    "autosize": true,
                    "symbol": symbol,
                    "interval": "5",
                    "timezone": "America/New_York",
                    "theme": "dark",
                    "style": "1",
                    "locale": "zh_TW",
                    "toolbar_bg": "#0f172a",
                    "enable_publishing": false,
                    "hide_side_toolbar": false,
                    "allow_symbol_change": true,
                    "container_id": "tv_chart_container"
                });
                document.getElementById('currentChartTicker').innerText = symbol;
            } else {
                container.innerHTML = '<div class="flex items-center justify-center h-full text-xs text-rose-400">TradingView 圖表腳本載入失敗，請檢查網絡或 AdBlock。</div>';
            }
        }

        function changeSymbol(symbol) {
            initTradingViewWidget(symbol);
        }

        async function fetchStockQuote() {
            const symbol = document.getElementById('symbolInput').value.trim().toUpperCase();
            if(!symbol) return;
            const apiKey = 'dbcscohr01qioilb79ugdbcscohr01qioilb79v0';
            
            try {
                const response = await fetch(`https://finnhub.io/api/v1/quote?symbol=${symbol}&token=${apiKey}`);
                const data = await response.json();

                if(data && data.c && data.c !== 0) {
                    currentQuoteData = { symbol, price: data.c, high: data.h, low: data.l, open: data.o, prevClose: data.pc };
                    document.getElementById('quoteSymbol').innerText = symbol;
                    document.getElementById('quotePrice').innerText = `$${data.c.toFixed(2)}`;
                    const isPositive = data.d >= 0;
                    const changeElem = document.getElementById('quoteChange');
                    changeElem.innerText = `${isPositive ? '+' : ''}${data.d.toFixed(2)} (${isPositive ? '+' : ''}${data.dp.toFixed(2)}%)`;
                    changeElem.className = `text-xs font-mono ${isPositive ? 'text-emerald-400' : 'text-rose-400'}`;
                    document.getElementById('quoteHigh').innerText = `$${data.h.toFixed(2)}`;
                    document.getElementById('quoteLow').innerText = `$${data.l.toFixed(2)}`;
                    document.getElementById('quoteOpen').innerText = `$${data.o.toFixed(2)}`;
                    document.getElementById('quotePrevClose').innerText = `$${data.pc.toFixed(2)}`;
                    document.getElementById('tradeTicker').value = symbol;
                    document.getElementById('entryPrice').value = data.c.toFixed(2);
                    calculatePosition();
                } else {
                    alert('無法抓取該股票數據，請確認代號是否正確。');
                }
            } catch(e) { console.error(e); }
        }

        function calculatePosition() {
            const accountSize = parseFloat(document.getElementById('accountSize').value) || 0;
            const riskPercent = parseFloat(document.getElementById('riskPercent').value) || 0;
            const entryPrice = parseFloat(document.getElementById('entryPrice').value) || 0;
            const stopPrice = parseFloat(document.getElementById('stopPrice').value) || 0;
            const targetPrice = parseFloat(document.getElementById('targetPrice').value) || 0;

            const maxRiskUSD = accountSize * (riskPercent / 100);
            const riskPerShare = Math.abs(entryPrice - stopPrice);
            document.getElementById('calcRiskPerShare').innerText = `$${riskPerShare.toFixed(2)}`;

            if(riskPerShare > 0 && entryPrice > 0) {
                const shares = Math.floor(maxRiskUSD / riskPerShare);
                const posValue = shares * entryPrice;
                const rewardPerShare = Math.abs(targetPrice - entryPrice);
                const rrRatio = rewardPerShare / riskPerShare;
                document.getElementById('calcShares').innerText = `${shares} 股`;
                document.getElementById('calcPositionValue').innerText = `$${posValue.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                document.getElementById('calcRR').innerText = `1 : ${rrRatio.toFixed(2)}`;
            }
        }

        function updateChecklist() {
            const checkboxes = document.querySelectorAll('.chk-item');
            let checkedCount = 0;
            checkboxes.forEach(chk => { if(chk.checked) checkedCount++; });
            const statusElem = document.getElementById('checklistStatus');
            if(checkedCount === checkboxes.length) {
                statusElem.innerText = '✅ 紀律檢查完畢，准許執行進場！';
                statusElem.className = 'text-xs font-semibold text-emerald-400';
            } else {
                statusElem.innerText = '⚠️ 請先勾選所有紀律檢查項';
                statusElem.className = 'text-xs font-semibold text-rose-400';
            }
        }

        function toggleModal(id) { document.getElementById(id).classList.toggle('hidden'); }
    </script>
</body>
</html>
